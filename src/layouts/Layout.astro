---
// Shared layout component imports global Tailwind stylesheet
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" /> -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta
      name="apple-mobile-web-app-title"
      content="dmitry-makovsky.github.io"
    />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <slot name="title">
      <title>dmitry-makovsky.github.io</title>
    </slot>
  </head>
  <body
    class="antialiased bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 grid min-h-screen"
  >
    <div class="container mx-auto px-4 py-8">
      <slot />
    </div>
  </body>
</html>
